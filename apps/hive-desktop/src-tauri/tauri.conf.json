{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hiveCrypto",
  "version": "0.1.0",
  "identifier": "io.hivecrypto.desktop",
  "build": {
    "beforeDevCommand": "bun ../../scripts/build-desktop.ts --dev",
    "beforeBuildCommand": "bun ../../scripts/build-desktop.ts",
    "frontendDist": "../../../packages/hive-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/hive-gateway"
    ],
    "linux": {
      "deb": {
        "preInstallScript": "scripts/linux-preinstall.sh"
      },
      "rpm": {
        "preInstallScript": "scripts/linux-preinstall.sh"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0OTg4NDQ3RTQxQjA3RkIKUldUN0J4dmtSNFNZMU9xQk56NDBNb2ZtZk8rbGVnMmJ6NVJmdlVBUmo3M1hZeHlyVmp4ZGtBOVEK",
      "endpoints": [
        "https://github.com/johpaz/hiveCrypto/releases/latest/download/latest.json"
      ]
    }
  }
}
